#!/bin/sh
# wp-env-macos — a wp-env replacement backed by Apple `container` via opossum.
#
# Drives the compose.yaml stack (no Podman/Docker Desktop VM) and provisions a
# runnable WordPress instance — the `npm run env:install` equivalent: wp core
# install (dev + tests), wp-config constants, plugin/theme activation, and
# wp-tests-config.php generation. This mirrors @wordpress/env's configureWordPress
# step, translated from `docker compose` to `opossum exec`.
#
# Usage: see `wp-env-macos help` (or `wp-env-macos --help`).
#
# Requires macOS 26+ / Apple silicon, `container` running, and opossum installed.
# Database reachability uses container-name DNS: wp-env-macos runs
# `sudo container system dns create opossum` ONCE (idempotent) on first `up`,
# after which app containers reach the DB by bare service name (mysql /
# tests-mysql) — no host LAN IP or published DB ports needed.

# Configuration (all optional; sensible defaults apply):
#   WP_PLUGIN_SLUG        plugin directory name under wp-content/plugins
#                         (default: current directory basename)
#   WP_ENV_CACHE_DIR      path to @wordpress/env's cache (populated by `wp-env
#                         start` once, or by `wp-env-macos install-wp-tests`)
#   WP_ENV_PORT / WP_ENV_TESTS_PORT
#   HOST_USERNAME / HOST_UID / HOST_GID   (auto-detected from `id` if unset)
#   WP_ENV_FIXTURE_PLUGINS / WP_ENV_FIXTURE_THEMES
#                         space-separated host paths mounted into the containers
#                         as fixture plugins/themes (e.g. tests/fixtures/.../*)
#   WP_ENV_DEV_THEME      theme activated on the dev site (default twentytwentyfive)
#   XDEBUG_HOST           IP/host xdebug connects back to (default host.docker.internal)

set -e

# --- Load the project .env (scaffolded by `init`) ---
# Plain KEY=VALUE lines only; never override a value already in the
# environment (an explicit `export` in the shell wins over the file).
if [ -f .env ]; then
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
			''|\#*) continue ;;
			*=*)
				key="${line%%=*}"
				val="${line#*=}"
				# Only set keys that aren't already exported.
				[ -n "$key" ] && [ -z "$(eval "printf '%s' \"\${$key+x}\"")" ] \
					&& export "$key=$val"
				;;
		esac
	done < .env
fi

# --- Locate the package root (where templates/ and docker/ live) ---
# When installed via npm, the bin is symlinked into node_modules/.bin, so $0
# points at the symlink. Resolve it to the real file first.
if [ -L "$0" ]; then
	SCRIPT_DIR="$(cd "$(dirname "$(readlink "$0")")" && pwd)"
else
	SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
fi
PKG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
[ -d "$PKG_ROOT/templates" ] || PKG_ROOT="$SCRIPT_DIR"

# --- Host environment (auto-detected; explicit values win) ---
export HOST_USERNAME="${HOST_USERNAME:-$(id -un)}"
export HOST_UID="${HOST_UID:-$(id -u)}"
export HOST_GID="${HOST_GID:-$(id -g)}"
export XDEBUG_HOST="${XDEBUG_HOST:-host.docker.internal}"

OPOSSUM="${OPOSSUM:-opossum}"
COMPOSE="${COMPOSE:-compose.yaml}"

# Project context.
PROJECT_NAME="$(basename "$PWD")"
WP_PLUGIN_SLUG="${WP_PLUGIN_SLUG:-$PROJECT_NAME}"
DEV_PORT="${WP_ENV_PORT:-8888}"
TESTS_PORT="${WP_ENV_TESTS_PORT:-8889}"
DEV_THEME="${WP_ENV_DEV_THEME:-twentytwentyfive}"

# One-time DNS setup so bare service names (mysql, tests-mysql) resolve across
# the opossum-managed containers. Idempotent: only run sudo when the
# `opossum` DNS domain isn't already registered (checked via `dns list`).
ensure_dns() {
	if ! container system dns list 2>/dev/null | grep -qx opossum; then
		echo "mac-env: setting up container DNS (one-time, requires sudo)…"
		sudo container system dns create opossum || true
	fi
}

# List all wp-env cache subdirs (one per project), newline-separated.
list_cache_dirs() {
	local cache_root="$HOME/.wp-env"
	[ -d "$cache_root" ] || return 0
	find "$cache_root" -maxdepth 1 -type d ! -name "$(basename "$cache_root")" 2>/dev/null || true
}

# Detect the wp-env cache dir: if ~/.wp-env has exactly one subdirectory,
# use it; otherwise emit nothing (caller leaves WP_ENV_CACHE_DIR blank).
detect_cache_dir() {
	local dirs count
	dirs="$(list_cache_dirs)"
	count="$(printf '%s\n' $dirs | grep -c . || true)"
	[ "$count" = "1" ] && printf '%s' "$dirs"
}

# --- `init`: scaffold compose.yaml + .env into the current project ---
do_init() {
	# If compose.yaml already exists, re-init is allowed — automatically force
	# the overwrite (equivalent to running with WP_ENV_FORCE_INIT=1) instead of
	# refusing.
	if [ -f compose.yaml ]; then
		[ -n "$WP_ENV_FORCE_INIT" ] || echo "mac-env: compose.yaml already exists — re-initializing (overwrite forced)." >&2
		WP_ENV_FORCE_INIT=1
	fi
	# Determine the plugin slug: it's the project directory name, since the
	# project root is mounted at wp-content/plugins/<slug>. (.wp-env.json may
	# list "." or a path; we don't derive the slug from it to stay robust.)
	local slug="$PROJECT_NAME"
	WP_PLUGIN_SLUG="$slug"

	# Discover fixture plugins/themes under common test paths.
	local fx_plugins="" fx_themes=""
	if [ -d tests/fixtures/plugins ]; then
		for d in tests/fixtures/plugins/*/; do
			[ -d "$d" ] && fx_plugins="$fx_plugins${fx_plugins:+ }${d%/}"
		done
	fi
	if [ -d tests/fixtures/themes ]; then
		for d in tests/fixtures/themes/*/; do
			[ -d "$d" ] && fx_themes="$fx_themes${fx_themes:+ }${d%/}"
		done
	fi
	WP_ENV_FIXTURE_PLUGINS="${WP_ENV_FIXTURE_PLUGINS:-$fx_plugins}"
	WP_ENV_FIXTURE_THEMES="${WP_ENV_FIXTURE_THEMES:-$fx_themes}"

	# Scaffold a .wp-env.json if the project doesn't have one (wp-env convention).
	if [ ! -f .wp-env.json ]; then
		cat > .wp-env.json <<'JSON'
{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"plugins": [ "." ]
}
JSON
		echo "mac-env: created .wp-env.json — add \"phpVersion\": \"8.2\" to change the container PHP version."
	fi

	# Render the template compose file.
	render_compose > compose.yaml
	# Copy the docker/ build context into the project so builds resolve locally.
	mkdir -p docker
	cp -R "$PKG_ROOT/docker/." docker/ 2>/dev/null || true

	# Add wp-env-macos scripts to package.json (idempotent).
	sync_package_scripts
	# Write/extend .env. If it already exists (e.g. from another tool), append
	# the wp-env-macos keys rather than overwriting — but only once, guarded
	# by a marker comment so re-running init is idempotent.
	if [ ! -f .env ]; then
		render_env > .env
	elif ! grep -q '# wp-env-macos' .env 2>/dev/null; then
		{
			echo ''
			echo '# wp-env-macos'
			render_env_body
		} >> .env
	fi

	# Append wp-env-macos ignores if not already present (idempotent per
	# entry, so re-running init after a partial block still completes it).
	for entry in '.env' '.opossum-home/' 'docker/' 'compose.yaml'; do
		grep -qxF "$entry" .gitignore 2>/dev/null || printf '%s\n' "$entry" >> .gitignore
	done

	echo "mac-env: initialized in $(pwd)"
	echo "  plugin slug : $WP_PLUGIN_SLUG"
	echo "  fixtures    : ${WP_ENV_FIXTURE_PLUGINS:-none} ${WP_ENV_FIXTURE_THEMES:+| $WP_ENV_FIXTURE_THEMES}"
	[ -f package.json ] && echo "  scripts     : added env:start/env:stop/env:install/test[/:multisite/:coverage/:php80] to package.json"
	# Auto-fill WP_ENV_CACHE_DIR in .env when it's not already set and exactly
	# one complete cache exists (re-running init converges on the right cache).
	if [ -z "$WP_ENV_CACHE_DIR" ]; then
		cache_dir="$(detect_cache_dir || true)"
		if [ -n "$cache_dir" ] && cache_dir_is_complete "$cache_dir"; then
			echo "mac-env: auto-filling WP_ENV_CACHE_DIR in .env ($cache_dir)"
			write_cache_dir_to_env "$cache_dir"
		fi
	else
		cache_dir="$WP_ENV_CACHE_DIR"
	fi
	# Surface the wp-env cache dir so the user can paste it into .env.
	cache_dir="${cache_dir:-$(detect_cache_dir || true)}"
	if [ -n "$cache_dir" ]; then
		echo "  cache dir   : $cache_dir"
		echo "    → copy into .env:  WP_ENV_CACHE_DIR=$cache_dir"
	elif [ -d "$HOME/.wp-env" ]; then
		echo "  cache dir   : (multiple found under ~/.wp-env — any complete one works)"
		echo "    → run:  wp-env-macos cache-list"
		echo "      pick a dir with WordPress/, tests-WordPress/, *-PHPUnit/ subdirs"
		echo "    → copy that into .env as:  WP_ENV_CACHE_DIR=<path>"
	else
		echo "  cache dir   : (not found — ~/.wp-env missing)"
		echo "    → run 'wp-env-macos install-wp-tests' (or 'wp-env start' once) to populate it, then re-run 'wp-env-macos init'"
	fi
	echo "  next steps  : set WP_ENV_CACHE_DIR in .env, then 'wp-env-macos up'"
}

# Add wp-env-macos scripts to package.json if it exists, idempotently.
# Uses `npm pkg set` so existing scripts are preserved and JSON stays valid.
sync_package_scripts() {
	[ -f package.json ] || return 0
	npm pkg set scripts.env:start="wp-env-macos up" >/dev/null 2>&1 || true
	npm pkg set scripts.env:stop="wp-env-macos down" >/dev/null 2>&1 || true
	npm pkg set scripts.env:install="wp-env-macos provision" >/dev/null 2>&1 || true
	npm pkg set scripts.test="wp-env-macos test" >/dev/null 2>&1 || true
	npm pkg set scripts.test:multisite="wp-env-macos test:multisite" >/dev/null 2>&1 || true
	npm pkg set scripts.test:coverage="wp-env-macos test:coverage" >/dev/null 2>&1 || true
	npm pkg set scripts.test:php80="wp-env-macos test:php80" >/dev/null 2>&1 || true
}

render_compose() {
	# Render the template: replace placeholders with project-specific values.
	python3 - "$WP_PLUGIN_SLUG" "$WP_ENV_FIXTURE_PLUGINS" "$WP_ENV_FIXTURE_THEMES" "$DEV_THEME" "$PKG_ROOT/templates/compose.yaml.tpl" <<'PY'
import sys, os, json
slug, fx_plugins, fx_themes, dev_theme, tpl = sys.argv[1:6]
pwd = os.getcwd()
def mount_lines(paths):
    out=[]
    for p in paths.split():
        out.append(f"      - '{pwd}/{p}:/var/www/html/wp-content/plugins/{p.split('/')[-1]}'")
    return "\n".join(out)
def theme_lines(paths):
    out=[]
    for p in paths.split():
        out.append(f"      - '{pwd}/{p}:/var/www/html/wp-content/themes/{p.split('/')[-1]}'")
    return "\n".join(out)
s=open(tpl, encoding='utf-8').read()
try:
    php = str(json.load(open('.wp-env.json')).get('phpVersion') or '')
except Exception:
    php = ''
s=s.replace('@@PLUGIN_SLUG@@', slug)
s=s.replace('@@PHP_VERSION@@', php or '8.2')
s=s.replace('@@DEV_THEME@@', dev_theme)
s=s.replace('@@FIXTURE_PLUGIN_MOUNTS@@', mount_lines(fx_plugins) or "# (no fixture plugins)")
s=s.replace('@@FIXTURE_THEME_MOUNTS@@', theme_lines(fx_themes) or "# (no fixture themes)")
sys.stdout.write(s)
PY
}

render_env_body() {
	cat <<EOF
# Path to @wordpress/env's cache (populated by 'wp-env start' once, or by
# 'wp-env-macos install-wp-tests'). Found via:
#   wp-env-macos cache-list   (auto-detected below if exactly one exists)
WP_ENV_CACHE_DIR=${WP_ENV_CACHE_DIR:-$(detect_cache_dir)}

# Host user identity is auto-detected by wp-env-macos from 'id' — usually no need to set.
# HOST_USERNAME=
# HOST_UID=
# HOST_GID=

# Published ports (defaults match @wordpress/env: 8888 dev, 8889 tests).
# The database is reached by container-name DNS (mysql / tests-mysql), so no
# DB ports are published.
WP_ENV_PORT=8888
WP_ENV_TESTS_PORT=8889

# Plugin directory name under wp-content/plugins (default: project dir name).
# WP_PLUGIN_SLUG=$PROJECT_NAME

# Theme activated on the dev site so it renders a real page (not a fixture stub).
WP_ENV_DEV_THEME=twentytwentyfive
EOF
}

render_env() {
	echo "# wp-env-macos environment — generated by 'wp-env-macos init'."
	echo ''
	render_env_body
}

# --- Animated progress spinner (TTY only) ---
# Usage:  start_spinner "cloning WordPress core…"
#         …slow work…
#         stop_spinner
# The spinner only animates when stdout is a terminal (skipped for pipes/CI).
# Braille frames are multibyte UTF-8, so we index them as positional params
# (set -- …) and pull each with `eval "g=\${$n}"` — portable, no byte math.
_SPINNER_PID=""
_SPINNER_LABEL=""
start_spinner() {
	# Never start a second spinner while one is running.
	[ -n "$_SPINNER_PID" ] && return 0
	_SPINNER_LABEL="$1"
	[ -t 1 ] || return 0
	printf '%s' "$_SPINNER_LABEL"
	( set +x
	  set -- '⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏'
	  local i=0 g
	  trap 'exit 0' TERM
	  while true; do
		eval "g=\${$((i % 10 + 1))}"
		printf '\r%s %s' "$g" "$_SPINNER_LABEL"
		i=$((i + 1))
		sleep 0.1
	  done
	) &
	_SPINNER_PID=$!
}
stop_spinner() {
	[ -n "$_SPINNER_PID" ] && kill "$_SPINNER_PID" 2>/dev/null && wait "$_SPINNER_PID" 2>/dev/null
	_SPINNER_PID=""
	[ -t 1 ] && printf '\r\033[K'
	# Always succeed: the final `[ -t 1 ]` is false in non-TTY and would
	# otherwise make `set -e` abort the caller.
	return 0
}

# --- Variant 2: git-based WordPress core + PHPUnit test-lib fetch ---

# Resolve a wp-version argument into a git ref.
#   X.Y.Z       -> tag "X.Y.Z"
#   trunk        -> branch "trunk"
#   latest|""   -> query api.wordpress.org for the latest stable tag
resolve_wp_version() {
	local v="${1:-latest}"
	if [ "$v" = "trunk" ]; then
		# The release repo's trunk lives on `master` (wordpress-develop uses
		# `trunk`); keep the pinned version label as "trunk" for readability.
		printf 'trunk:master'
		return
	fi
	if [ "$v" = "latest" ] || [ -z "$v" ]; then
		local json
		json="$(curl -s http://api.wordpress.org/core/version-check/1.7/ 2>/dev/null || true)"
		v="$(printf '%s' "$json" | grep -o '"version":"[^"]*' | sed 's/"version":"//' | head -1)"
		[ -n "$v" ] || { echo "mac-env: latest WordPress version could not be found" >&2; return 1; }
	fi
	printf '%s' "$v"
}

# Shared sync: clone-or-pull the two source repos into <cache>/.src-* and
# arrange them into the four consumed subdirs, then rewrite wp-tests-config.php.
# Idempotent: re-running with the same tag is a fetch + rsync (deltas only).
sync_wp_env_cache() {
	cache_dir="$1"
	tag="$2"
	src_wp="$cache_dir/.src-wordpress"
	src_dev="$cache_dir/.src-develop"

	# The tag may carry an explicit branch suffix (e.g. "trunk:master"); split
	# it out here, before any `local` shadows the positional params below.
	wp_branch="${tag#*:}"
	wp_tag="${tag%:*}"

	# --- WordPress/WordPress (release core) -> WordPress/ + tests-WordPress/ ---
	start_spinner "cloning WordPress core ($tag)…"
	if [ -d "$src_wp/.git" ]; then
		# Trunk tracks a moving branch, so refresh the refs first: the
		# at-HEAD fast-path below must compare against the fresh remote tip,
		# not a stale local branch ref. `pull` also covers a clone whose
		# checkout isn't tracking the expected upstream.
		if [ "$wp_tag" = "trunk" ]; then
			git -C "$src_wp" fetch --tags --all >/dev/null 2>&1 || true
			git -C "$src_wp" pull --ff-only >/dev/null 2>&1 || true
		fi
		# Skip the network fetch + rsync when the clone already sits at $tag
		# (e.g. a re-pull of an unchanged pinned version) — makes re-runs fast.
		local check_ref="$wp_tag"
		[ "$wp_tag" = "trunk" ] && check_ref="$wp_branch"
		local at_wp="$(git -C "$src_wp" rev-parse "$check_ref" 2>/dev/null || true)"
		local cur_wp="$(git -C "$src_wp" rev-parse HEAD 2>/dev/null || true)"
		if [ -n "$at_wp" ] && [ "$at_wp" = "$cur_wp" ]; then
			git -C "$src_wp" checkout -q "$check_ref" >/dev/null 2>&1 || true
		elif [ "$wp_tag" != "trunk" ]; then
			git -C "$src_wp" fetch --tags >/dev/null 2>&1 || true
			git -C "$src_wp" checkout "$wp_tag" >/dev/null 2>&1 || true
		fi
	else
		rm -rf "$src_wp"
		git clone --depth 1 --branch "$wp_branch" https://github.com/WordPress/WordPress.git "$src_wp" >/dev/null 2>&1 || {
			stop_spinner
			echo "mac-env: failed to clone WordPress core from git" >&2
			return 1
		}
	fi
	mkdir -p "$cache_dir/WordPress" "$cache_dir/tests-WordPress"
	stop_spinner
	# Skip the copy only when the destination already has the core files we need
	# (a prior rsync succeeded) — otherwise a re-pull that skipped rsync would
	# leave tests-WordPress/ empty and break the test run. WP_ENV_SKIP_RSYNC=1
	# is an explicit force-skip for callers that have already verified the copy.
	if [ -z "$WP_ENV_SKIP_RSYNC" ] || [ ! -f "$cache_dir/tests-WordPress/wp-settings.php" ]; then
		start_spinner "copying WordPress core into cache…"
		rsync -a --delete --exclude=.git "$src_wp/" "$cache_dir/WordPress/"
		rsync -a --delete --exclude=.git "$src_wp/" "$cache_dir/tests-WordPress/"
		stop_spinner
	fi

	# --- WordPress/wordpress-develop (test framework) -> *-PHPUnit/tests/phpunit/ ---
	# (wordpress-develop's trunk branch is literally named "trunk", unlike the
	# release repo's "master", so override the branch for the trunk label.)
	dev_branch="${tag#*:}"
	dev_tag="${tag%:*}"
	[ "$dev_tag" = "trunk" ] && dev_branch="trunk"
	start_spinner "cloning wordpress-develop ($tag)…"
	if [ -d "$src_dev/.git" ]; then
		# Same moving-branch refresh as the core repo above: for trunk, fetch
		# first so the at-HEAD fast-path compares against the fresh remote tip.
		if [ "$dev_tag" = "trunk" ]; then
			git -C "$src_dev" fetch --tags --all >/dev/null 2>&1 || true
			git -C "$src_dev" pull --ff-only >/dev/null 2>&1 || true
		fi
		local dev_check_ref="$dev_tag"
		[ "$dev_tag" = "trunk" ] && dev_check_ref="$dev_branch"
		local at_dev="$(git -C "$src_dev" rev-parse "$dev_check_ref" 2>/dev/null || true)"
		local cur_dev="$(git -C "$src_dev" rev-parse HEAD 2>/dev/null || true)"
		if [ -n "$at_dev" ] && [ "$at_dev" = "$cur_dev" ]; then
			git -C "$src_dev" checkout -q "$dev_check_ref" >/dev/null 2>&1 || true
		elif [ "$dev_tag" != "trunk" ]; then
			git -C "$src_dev" fetch --tags >/dev/null 2>&1 || true
			git -C "$src_dev" checkout "$dev_tag" >/dev/null 2>&1 || true
		fi
	else
		rm -rf "$src_dev"
		git clone --depth 1 --branch "$dev_branch" https://github.com/WordPress/wordpress-develop.git "$src_dev" >/dev/null 2>&1 || {
			stop_spinner
			echo "mac-env: failed to clone wordpress-develop from git" >&2
			return 1
		}
	fi
	stop_spinner
	start_spinner "arranging PHPUnit libs + wp-tests-config.php…"
	for dst in "$cache_dir/WordPress-PHPUnit" "$cache_dir/tests-WordPress-PHPUnit"; do
		mkdir -p "$dst/tests/phpunit/includes"
		rsync -a --delete "$src_dev/tests/phpunit/includes/" "$dst/tests/phpunit/includes/"
		cp "$src_dev/wp-tests-config-sample.php" "$dst/tests/phpunit/wp-tests-config.php" 2>/dev/null || true
		# Rewrite the test config the same way install-wp-tests.sh does. The
		# config is mounted into the container at /wordpress-phpunit, where the
		# WordPress core (tests-WordPress) is bind-mounted at /var/www/html.
		# ABSPATH and WP_LANG_DIR must point at the in-container paths, not
		# the host cache dir.
		sed -i '' "s:dirname( __FILE__ ) . '/src/':'/var/www/html/':" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s/youremptytestdbnamehere/tests-wordpress/" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s/yourusernamehere/root/" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s/yourpasswordhere/password/" "$dst/tests/phpunit/wp-tests-config.php"
		sed -i '' "s|localhost|tests-mysql|" "$dst/tests/phpunit/wp-tests-config.php"
		inject_test_constants "$dst/tests/phpunit/wp-tests-config.php"
	done
	stop_spinner
}

# Seed the cache from git (replaces the wp-env dependency).
install_wp_tests() {
	local ver="${1:-latest}"
	local tag
	tag="$(resolve_wp_version "$ver")" || return 1
	local wp_tag="${tag%:*}"  # "X.Y.Z" | "trunk" (label used for the cache dir)

	# Pick the cache dir. Honor WP_ENV_CACHE_DIR whenever it's set (creating
	# it if needed); only fall back to detection/default when it's empty.
	local cache_dir=""
	if [ -n "$WP_ENV_CACHE_DIR" ]; then
		cache_dir="$WP_ENV_CACHE_DIR"
	elif [ "$(list_cache_dirs | grep -c . || true)" = "1" ]; then
		cache_dir="$(list_cache_dirs)"
	else
		cache_dir="$HOME/.wp-env/wp-env-macos-$wp_tag"
	fi
	mkdir -p "$cache_dir"

	# If the clone already exists, re-pull in place instead of re-cloning —
	# but only when the requested version matches the one already pinned.
	# A different tag is a *switch*: re-sync from scratch so the checked-out
	# trees, WordPress/ copies, and .wp-env-version all land on the new version.
	if [ -d "$cache_dir/.src-wordpress/.git" ]; then
		local pinned="$(cat "$cache_dir/.wp-env-version" 2>/dev/null || true)"
		if [ -n "$pinned" ] && [ "$pinned" != "$wp_tag" ]; then
			echo "mac-env: switching cache $cache_dir from $pinned to $wp_tag — re-syncing…"
			sync_wp_env_cache "$cache_dir" "$tag"
			printf '%s' "$wp_tag" > "$cache_dir/.wp-env-version"
			echo "mac-env: cache ready at $cache_dir"
			echo "  version     : $wp_tag"
			echo "  next step   : set WP_ENV_CACHE_DIR in .env (or run 'wp-env-macos init' to auto-fill), then 'wp-env-macos up'"
			return $?
		fi
		echo "mac-env: cache already seeded at $cache_dir — re-pulling (use 'wp-env-macos fetch' next time)…"
		# Skip the tree rsync so a re-pull of an unchanged pinned version is
		# near-instant; `fetch` does the full rsync when a real refresh is wanted.
		WP_ENV_SKIP_RSYNC=1 fetch_wp_env_cache "$cache_dir"
		return $?
	fi

	sync_wp_env_cache "$cache_dir" "$tag"
	printf '%s' "$wp_tag" > "$cache_dir/.wp-env-version"

	echo "mac-env: cache ready at $cache_dir"
	echo "  version     : $wp_tag"
	echo "  next step   : set WP_ENV_CACHE_DIR in .env (or run 'wp-env-macos init' to auto-fill), then 'wp-env-macos up'"
}

# Re-pull the pinned version in place (the git-fetch equivalent).
# Optional $1: explicit cache dir (used when install-wp-tests re-pulls an
# existing clone). Falls back to WP_ENV_CACHE_DIR / detect_cache_dir.
fetch_wp_env_cache() {
	local cache_dir="${1:-}"
	if [ -z "$cache_dir" ] && [ -n "$WP_ENV_CACHE_DIR" ] && [ -d "$WP_ENV_CACHE_DIR" ]; then
		cache_dir="$WP_ENV_CACHE_DIR"
	elif [ -z "$cache_dir" ]; then
		cache_dir="$(detect_cache_dir || true)"
	fi
	if [ -z "$cache_dir" ] || [ ! -d "$cache_dir" ]; then
		echo "mac-env: no cache dir found." >&2
		echo "  → run 'wp-env-macos install-wp-tests [version]' to seed one, then re-run." >&2
		echo "  → or pick an existing cache with 'wp-env-macos cache-list' (writes WP_ENV_CACHE_DIR to .env)." >&2
		if [ -d "$HOME/.wp-env" ] && [ -n "$(list_cache_dirs)" ]; then
			echo "  available caches under ~/.wp-env:" >&2
			list_cache_dirs_verbose >&2
		fi
		return 1
	fi
	local tag="$(cat "$cache_dir/.wp-env-version" 2>/dev/null || true)"
	if [ -z "$tag" ]; then
		# Fall back to the current checkout of the wordpress clone, if present.
		tag="$(git -C "$cache_dir/.src-wordpress" describe --tags 2>/dev/null || true)"
		if [ -z "$tag" ]; then
			echo "mac-env: no pinned version in $cache_dir/.wp-env-version — run 'wp-env-macos install-wp-tests [version]'." >&2
			return 1
		fi
	fi
	# The pinned label "trunk" lives on branch master in WordPress/WordPress
	# (mirrors resolve_wp_version); re-attach the suffix so sync_wp_env_cache
	# can split it back out for the clone/checkout step.
	[ "$tag" = "trunk" ] && tag="trunk:master"

	echo "mac-env: fetching WordPress ($tag) in $cache_dir …"
	sync_wp_env_cache "$cache_dir" "$tag"
	echo "mac-env: fetched $tag"
}

# List available cache dirs with their pinned version.
list_cache_dirs_verbose() {
	if [ ! -d "$HOME/.wp-env" ]; then
		echo "(no ~/.wp-env cache found)"
		return 0
	fi
	local found=0
	for d in $(list_cache_dirs); do
		found=1
		local ver="$(cat "$d/.wp-env-version" 2>/dev/null || true)"
		local marker="(unknown)"
		if [ -n "$ver" ]; then
			marker="(git)"
		elif [ -f "$d/WordPress/wp-settings.php" ]; then
			ver="—"; marker="(wp-env)"
		fi
		printf '%-55s %-10s %s\n' "$d" "${ver:-—}" "$marker"
	done
	[ "$found" = "0" ] && echo "(no ~/.wp-env cache dirs found)"
}

# A cache dir is "complete" if it has the four consumed subdirs wp-env-macos needs:
# WordPress/, tests-WordPress/, and a *-PHPUnit/ (for /wordpress-phpunit).
cache_dir_is_complete() {
	local d="$1"
	[ -d "$d/WordPress" ] && [ -d "$d/tests-WordPress" ] \
		&& ls -d "$d"/*-PHPUnit >/dev/null 2>&1
}

# Idempotently write WP_ENV_CACHE_DIR=<dir> into .env and print the export hint.
write_cache_dir_to_env() {
	local dir="$1"
	local line="WP_ENV_CACHE_DIR=$dir"

	if [ ! -f .env ]; then
		{
			echo '# wp-env-macos'
			echo "$line"
		} > .env
	elif grep -q '# wp-env-macos' .env; then
		if grep -q '^WP_ENV_CACHE_DIR=' .env; then
			# '#' delimiter avoids clashing with '/' in the path.
			sed -i '' "s#^WP_ENV_CACHE_DIR=.*#$line#" .env
		else
			# Marker present but line missing — append into the block.
			sed -i '' "/# wp-env-macos/a\\
$line" .env
		fi
	else
		# Foreign-owned .env — append the wp-env-macos block once.
		{
			echo ''
			echo '# wp-env-macos'
			echo "$line"
		} >> .env
	fi

	echo "mac-env: wrote '$line' to .env"
	echo "  (wp-env-macos reads .env automatically — no need to source it manually)"
}

# Interactive: pick a complete cache dir and write it to .env.
# Non-TTY, --list, or no complete dirs fall back to the plain verbose listing.
# Renders the choices as selectable [ ]/[x] checkboxes (radio-style: only one
# can be active at a time); typing a number toggles it, Enter confirms, 0
# cancels. Pure POSIX sh — no external dependencies.
cache_list() {
	if [ ! -t 1 ] || [ "$1" = "--list" ]; then
		list_cache_dirs_verbose
		return 0
	fi

	# Accumulate complete dirs as a plain newline-delimited list (POSIX sh has
	# no arrays); index later with sed -n "${n}p".
	local dirs="" n=0 d
	for d in $(list_cache_dirs); do
		if cache_dir_is_complete "$d"; then
			n=$((n + 1))
			dirs="$dirs$d
"
		fi
	done

	if [ "$n" -eq 0 ]; then
		echo "mac-env: no complete cache dirs under ~/.wp-env" >&2
		echo "  run 'wp-env-macos install-wp-tests' (or 'wp-env start') to populate one." >&2
		return 1
	fi

	# Render the checkbox menu with [ ]/[x] markers. Clear the
	# screen so the list re-draws cleanly on each toggle (ANSI escape).
	print_cache_menu() {
		local sel="$1" i=1
		printf '\033[2J\033[H'
		printf 'Select a wp-env cache dir for WP_ENV_CACHE_DIR:\n'
		while [ "$i" -le "$n" ]; do
			local mark="[ ]"
			[ "$i" = "$sel" ] && mark="[x]"
			printf '  %s %2d) %s\n' "$mark" "$i" "$(printf '%s' "$dirs" | sed -n "${i}p")"
			i=$((i + 1))
		done
	}

	local selected=0 choice
	while true; do
		print_cache_menu "$selected"
		printf 'Toggle number (Enter to confirm, 0 to cancel): '
		read -r choice
		# Empty input confirms the current selection.
		[ -z "$choice" ] && break
		[ "$choice" = "0" ] && return 0
		# Validate the choice is numeric and within range.
		case "$choice" in
			*[!0-9]*) echo "mac-env: invalid selection" >&2; continue ;;
		esac
		if [ "$choice" -lt 1 ] || [ "$choice" -gt "$n" ]; then
			echo "mac-env: invalid selection" >&2; continue
		fi
		# Radio-style toggle: re-typing the active choice clears it.
		if [ "$choice" = "$selected" ]; then
			selected=0
		else
			selected="$choice"
		fi
	done

	if [ "$selected" -eq 0 ]; then
		echo "mac-env: no selection made"
		return 0
	fi

	local chosen
	chosen="$(printf '%s' "$dirs" | sed -n "${selected}p")"
	[ -n "$chosen" ] || { echo "mac-env: invalid selection" >&2; return 1; }

	write_cache_dir_to_env "$chosen"
}

# Print the full command list (canonical — shown by `wp-env-macos help`).
print_help() {
	cat <<'EOF'
wp-env-macos (alias mac-env) — wp-env replacement backed by Apple `container` via opossum

Usage:
  wp-env-macos init              scaffold compose.yaml + .env + docker/; add scripts; gitignore
  wp-env-macos up                build + start + provision (install WordPress)
  wp-env-macos down              stop + remove (pass -v to also drop volumes)
  wp-env-macos provision         re-run just the WordPress install/activation step
  wp-env-macos test             run the PHPUnit suite in tests-cli
  wp-env-macos test:multisite / test:coverage / test:php80
  wp-env-macos coverage:check [--multisite] [--exclude <json>]
                        run the coverage suite, then gate on coverage/clover.xml.
                        With --multisite, also pass --exclude <json> for the
                        environment-only lines (see coverage-exclude.json).
  wp-env-macos coverage:summary [--exclude <json>]
                        run both coverage suites (single + multisite) and
                        display the coverage-check.php summary for each.
                        Defaults to --exclude coverage-exclude.json when present.
  wp-env-macos install-wp-tests [wp-version]   seed ~/.wp-env cache from git (X.Y.Z | trunk | latest)
  wp-env-macos fetch            re-pull the pinned WordPress version (git fetch in place)
  wp-env-macos cache-list       pick a populated ~/.wp-env cache dir; writes WP_ENV_CACHE_DIR to .env
  wp-env-macos help | --help   show this help

Any other argument is forwarded to `opossum -f compose.yaml`
(ps | logs | exec | run | config | ...).

First run: `wp-env-macos install-wp-tests`, then `wp-env-macos init`, then `wp-env-macos up`.
EOF
}

# Ensure the harness wp-tests-config.php points ABSPATH and WP_LANG_DIR at the
# in-container paths (not the host cache dir). WordPress is bind-mounted at
# /var/www/html inside the container, and the language dir must be defined or
# wp_get_installed_translations() short-circuits and returns [] (breaking
# coverage of the installed-translation branch). Idempotent: rewrites whatever
# value is currently present so re-provisioning is safe.
inject_test_constants() {
	local cfg="$1"
	[ -f "$cfg" ] || return 0
	# ABSPATH: in-container WordPress root.
	sed -i '' -E "s#^([ ]*)define\( *'ABSPATH'.*#\\1define( 'ABSPATH', '/var/www/html/' );#" "$cfg"
	# WP_LANG_DIR: in-container language dir.
	sed -i '' -E "s#^([ ]*)define\( *'WP_LANG_DIR'.*#\\1define( 'WP_LANG_DIR', '/var/www/html/wp-content/languages' );#" "$cfg"
	# If WP_LANG_DIR is not defined at all yet, append it after ABSPATH.
	if ! grep -q "define( *'WP_LANG_DIR'" "$cfg"; then
		sed -i '' "/define( *'ABSPATH'/a\\
\\
/* Language directory (must be defined so wp_get_installed_translations() can scan). */\\
define( 'WP_LANG_DIR', '/var/www/html/wp-content/languages' );" "$cfg"
	fi
}

# WordPress test bootstrap needs wp-tests-config.php in the core root.
generate_wp_tests_config() {
	if [ -n "$WP_ENV_CACHE_DIR" ]; then
		# Rewrite only the port, whatever the DB host (localhost or tests-mysql).
		sed -i '' -E "s#:[0-9]+\b#:${TESTS_PORT}#g" \
			"$WP_ENV_CACHE_DIR/tests-WordPress-PHPUnit/tests/phpunit/wp-tests-config.php" 2>/dev/null || true
		# Point ABSPATH and WP_LANG_DIR at the in-container paths.
		inject_test_constants "$WP_ENV_CACHE_DIR/tests-WordPress-PHPUnit/tests/phpunit/wp-tests-config.php"
	fi
	for svc in wordpress tests-wordpress; do
		if "$OPOSSUM" exec "$svc" cp /wordpress-phpunit/wp-tests-config.php /var/www/html/wp-tests-config.php 2>/dev/null; then
			"$OPOSSUM" exec "$svc" sh -c "sed -i -E 's#:[0-9]+\\b#:${TESTS_PORT}#g' /var/www/html/wp-tests-config.php" >/dev/null 2>&1 || true
		else
			echo "mac-env: $svc: /wordpress-phpunit/wp-tests-config.php not found — run 'wp-env-macos install-wp-tests' or 'wp-env start' once to populate the cache." >&2
		fi
	done
}

# Install WordPress (dev + tests), apply config, activate. Idempotent.
provision() {
	local plugins=""
	themes=""
	if [ -f .wp-env.json ]; then
		plugins="$(python3 -c "import json; d=json.load(open('.wp-env.json')); print(' '.join([p.rstrip('/').split('/')[-1] for p in d.get('plugins',[])]))" 2>/dev/null)"
		themes="$(python3 -c "import json; d=json.load(open('.wp-env.json')); print(' '.join([t.rstrip('/').split('/')[-1] for t in d.get('themes',[])]))" 2>/dev/null)"
	fi

	# --- Development site ---
	if ! "$OPOSSUM" exec cli wp core is-installed >/dev/null 2>&1; then
		"$OPOSSUM" exec cli wp core install \
			--url="http://localhost:${DEV_PORT}" \
			--title="$PROJECT_NAME" \
			--admin_user=admin --admin_password=password \
			--admin_email=wordpress@example.com --skip-email >/dev/null 2>&1
	fi
	if [ -f .wp-env.json ]; then
		python3 -c "
import json
d=json.load(open('.wp-env.json'))
for env in d.get('env',{}).values():
	for k,v in (env.get('config') or {}).items():
		if v is None: continue
		val = '\"%s\"' % v if isinstance(v,str) else v
		print('wp config set %s %s%s' % (k, val, ' --raw' if not isinstance(v,str) else ''))
" 2>/dev/null | while read -r line; do
			"$OPOSSUM" exec cli wp $line >/dev/null 2>&1 || true
		done
	fi
	# Activate on the DEV site only; the test install is bootstrapped fresh.
	[ -n "$plugins" ] && "$OPOSSUM" exec cli wp plugin activate $plugins >/dev/null 2>&1 || true
	[ -n "$themes" ] && "$OPOSSUM" exec cli wp theme activate $themes >/dev/null 2>&1 || true
	"$OPOSSUM" exec cli wp theme activate "$DEV_THEME" >/dev/null 2>&1 || true
	# Keep the site URL in sync with the current port (wp-env bakes it into
	# wp-config.php constants that override the DB).
	"$OPOSSUM" exec wordpress sh -c "sed -i 's#http://localhost:[0-9]*#http://localhost:${DEV_PORT}#g' /var/www/html/wp-config.php" >/dev/null 2>&1 || true
	[ -n "$WP_ENV_CACHE_DIR" ] && sed -i '' "s#http://localhost:[0-9]*#http://localhost:${DEV_PORT}#g" "$WP_ENV_CACHE_DIR/WordPress/wp-config.php" 2>/dev/null || true
	"$OPOSSUM" exec cli wp option update home "http://localhost:${DEV_PORT}" >/dev/null 2>&1 || true
	"$OPOSSUM" exec cli wp option update siteurl "http://localhost:${DEV_PORT}" >/dev/null 2>&1 || true

	# --- Tests site ---
	if ! "$OPOSSUM" exec tests-cli wp core is-installed >/dev/null 2>&1; then
		"$OPOSSUM" exec tests-cli wp core install \
			--url="http://localhost:${TESTS_PORT}" \
			--title="$PROJECT_NAME" \
			--admin_user=admin --admin_password=password \
			--admin_email=wordpress@example.com --skip-email >/dev/null 2>&1
	fi

	generate_wp_tests_config
}

run_tests() {
	local mode="${1:-default}"
	shift
	[ "$1" = "--" ] && shift
	case "$mode" in
		multisite) export WP_MULTISITE=1; coverage_flags="" ;;
		coverage) export WP_MULTISITE=0; coverage_flags="--coverage-clover=/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/coverage/clover.xml --coverage-text" ;;
		coverage-multisite) export WP_MULTISITE=1; coverage_flags="--coverage-clover=/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/coverage/clover-multisite.xml --coverage-text" ;;
		php80) export WP_MULTISITE=0; coverage_flags="" ;;
		*) export WP_MULTISITE=0; coverage_flags="" ;;
	esac
	"$OPOSSUM" exec tests-cli env \
	WP_MULTISITE="$WP_MULTISITE" \
	WP_TESTS_PHPUNIT_POLYFILLS_PATH=/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/vendor/yoast/phpunit-polyfills \
	/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/vendor/bin/phpunit \
	--config=/var/www/html/wp-content/plugins/${WP_PLUGIN_SLUG}/phpunit.xml \
	--colors=always \
	$coverage_flags \
	"$@"
}

# Run both coverage suites (single-site + multisite) and display summary.
# Hides test output, shows a spinner, then reports coverage via coverage-check.php.
do_coverage_summary() {
	local exclude_flag=""
	local exclude_file="coverage-exclude.json"
	local tmpfile
	
	# Parse --exclude flag, default to coverage-exclude.json if it exists
	while [ $# -gt 0 ]; do
		case "$1" in
			--exclude)
				exclude_flag="--exclude ${2:-}"
				shift
				;;
		esac
		shift
	done
	
	# Default to coverage-exclude.json if no --exclude specified and file exists
	if [ -z "$exclude_flag" ] && [ -f "$exclude_file" ]; then
		exclude_flag="--exclude $exclude_file"
	fi
	
	# Run single-site coverage tests
	start_spinner "Running single-site coverage tests..."
	run_tests coverage > /dev/null 2>&1 || { stop_spinner; return $?; }
	stop_spinner
	
	echo "=== Single-site coverage ==="
	php "$SCRIPT_DIR/coverage-check.php" coverage/clover.xml $exclude_flag
	local single_exit=$?
	echo ""
	
	# Run multisite coverage tests
	start_spinner "Running multisite coverage tests..."
	run_tests coverage-multisite > /dev/null 2>&1 || { stop_spinner; return $?; }
	stop_spinner
	
	echo "=== Multisite coverage ==="
	php "$SCRIPT_DIR/coverage-check.php" --multisite coverage/clover-multisite.xml $exclude_flag
	local multi_exit=$?
	
	# Exit non-zero if either check has gaps
	[ $single_exit -eq 0 ] && [ $multi_exit -eq 0 ]
}

# Run the coverage suite, then gate host-side on the bind-mounted clover.
# clover is written inside the container but bind-mounted to the plugin root,
# so it is readable from the host. Plugins may pass --exclude <json> for
# environment-only line exclusions (see coverage-exclude.json convention).
run_coverage_check() {
	local ms_flag=""
	local exclude_flag=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--multisite) ms_flag="--multisite" ;;
			--exclude) exclude_flag="--exclude ${2:-}"; shift ;;
		esac
		shift
	done
	# --multisite must drive the test run (WP_MULTISITE=1), not just the gate.
	local mode="coverage"
	local clover="coverage/clover.xml"
	[ -n "$ms_flag" ] && { mode="coverage-multisite"; clover="coverage/clover-multisite.xml"; }
	run_tests "$mode" || return $?
	php "$SCRIPT_DIR/coverage-check.php" $ms_flag "$clover" $exclude_flag
}

case "$1" in
	help|--help|"") print_help ;;
	init) do_init ;;
	up)
		# Apple `container`/opossum won't auto-create bind-mount sources, so
		# ensure the container home dirs exist (pure runtime scratch space;
		# gitignored, regenerated empty on clone).
		mkdir -p .opossum-home/user .opossum-home/tests-user
		ensure_dns
		"$OPOSSUM" -f "$COMPOSE" up "${@:2}"
		provision
		;;
	down)
		"$OPOSSUM" -f "$COMPOSE" down "${@:2}"
		;;
	provision) provision ;;
	install-wp-tests) install_wp_tests "${2:-latest}" ;;
	fetch) fetch_wp_env_cache ;;
	cache-list) cache_list "${@:2}" ;;
	test) run_tests default "${@:2}" ;;
	test:multisite) run_tests multisite "${@:2}" ;;
	test:coverage) run_tests coverage "${@:2}" ;;
	coverage:check) run_coverage_check "${@:2}" ;;
	coverage:summary) do_coverage_summary ;;
	test:php80) run_tests php80 "${@:2}" ;;
	*)
		"$OPOSSUM" -f "$COMPOSE" "$@"
		;;
esac
